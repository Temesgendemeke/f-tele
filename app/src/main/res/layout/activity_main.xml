<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <!-- App Header & Master Switch -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="F*ck Tele"
                    android:textColor="@color/ink"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02" />

                <TextView
                    android:id="@+id/tv_offline_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="OFFLINE"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:textColor="@color/accent"
                    android:background="@drawable/bg_chip_shown" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Hides ad notifications. Your messages are never deleted."
                android:textColor="@color/sub"
                android:textSize="13sp" />
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_master"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Permission Warning Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_permission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/blockSoft"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notification access is off"
                android:textColor="@color/block"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Android needs your permission before this app can hide notifications. Open the list, find F*ck Tele and turn it on."
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_open_access"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:text="Open notification access"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="14sp"
                android:background="@color/block" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Mode Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="What should be muted?"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/toggle_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_mode_blocklist"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_radio_segment"
                    android:text="Only blocked"
                    android:textColor="@color/text_color_radio_segment"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_mode_allowlist"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_radio_segment"
                    android:text="All except allowed"
                    android:textColor="@color/text_color_radio_segment"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_mode_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp"
                tools:text="Only senders and words on your block list are muted. Everything else rings as usual." />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Navigation Tabs (Activity | Shields | Rules) -->
    <LinearLayout
        android:id="@+id/tab_container"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_segmented_tab"
        android:orientation="horizontal"
        android:padding="3dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_tab_activity"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_indicator"
            android:text="Activity (0)"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_tab_shields"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:text="Shields"
            android:textColor="@color/sub"
            android:textSize="12sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_tab_rules"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:text="Custom Rules (0)"
            android:textColor="@color/sub"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Tab View Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp">

        <!-- 1. Activity Tab -->
        <LinearLayout
            android:id="@+id/layout_activity"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_activity"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingHorizontal="16dp"
                android:paddingTop="6dp"
                android:clipToPadding="false" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/layout_empty_activity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="No messages seen yet. New SMS notifications will appear here with the interception reason and quick controls."
                    android:textColor="@color/ink"
                    android:textSize="14sp"
                    android:lineSpacingExtra="3dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_simulate_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginTop="16dp"
                    android:text="Simulate Real SMS"
                    android:textColor="@color/accent"
                    android:textStyle="bold"
                    android:background="@drawable/bg_chip_shown"
                    android:paddingHorizontal="16dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_clear_activity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:text="Clear activity"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="?attr/selectableItemBackground" />
        </LinearLayout>

        <!-- 2. Smart Shields Tab -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/layout_shields"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:paddingHorizontal="16dp"
            android:clipToPadding="false"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="36dp">

                <!-- Shields Overview Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Smart Behavior Muting"
                            android:textColor="@color/ink"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Carriers send critical OTPs and transaction receipts, but also push endless lottery and marketing ads from the same number. These shields selectively silence spam behavior without ever muting your banking or security codes."
                            android:textColor="@color/sub"
                            android:textSize="13sp"
                            android:lineSpacingExtra="2dp" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_simulate_shield"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginTop="12dp"
                            android:text="Simulate Sample From Your Export"
                            android:textColor="@color/accent"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            android:background="@drawable/bg_chip_shown" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Container for category shields dynamically rendered -->
                <LinearLayout
                    android:id="@+id/layout_shields_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- 3. Custom Rules & Try-It Tab -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/layout_rules"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:paddingHorizontal="16dp"
            android:clipToPadding="false"
            tools:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="36dp">

                <!-- Add Rule Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Add new rule"
                            android:textColor="@color/ink"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Text or pattern"
                            android:textColor="@color/sub"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/et_draft_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_input"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="10dp"
                            android:hint="e.g. lottery, loan, *won*, 605"
                            android:textColorHint="@color/sub"
                            android:textColor="@color/ink"
                            android:textSize="14sp"
                            android:inputType="textNoSuggestions" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Specific sender (optional)"
                            android:textColor="@color/sub"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/et_draft_sender"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_input"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="10dp"
                            android:hint="e.g. ethio tel or 127 · Leave blank for all"
                            android:textColorHint="@color/sub"
                            android:textColor="@color/ink"
                            android:textSize="14sp"
                            android:inputType="textNoSuggestions" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Match in"
                            android:textColor="@color/sub"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <RadioGroup
                            android:id="@+id/toggle_target"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal">

                            <RadioButton
                                android:id="@+id/btn_target_sender"
                                android:layout_width="0dp"
                                android:layout_height="38dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="4dp"
                                android:button="@null"
                                android:gravity="center"
                                android:background="@drawable/bg_radio_segment"
                                android:text="Sender"
                                android:textColor="@color/text_color_radio_segment"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <RadioButton
                                android:id="@+id/btn_target_body"
                                android:layout_width="0dp"
                                android:layout_height="38dp"
                                android:layout_weight="1"
                                android:layout_marginHorizontal="2dp"
                                android:button="@null"
                                android:gravity="center"
                                android:background="@drawable/bg_radio_segment"
                                android:text="Message"
                                android:textColor="@color/text_color_radio_segment"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <RadioButton
                                android:id="@+id/btn_target_both"
                                android:layout_width="0dp"
                                android:layout_height="38dp"
                                android:layout_weight="1"
                                android:layout_marginStart="4dp"
                                android:button="@null"
                                android:gravity="center"
                                android:background="@drawable/bg_radio_segment"
                                android:text="Both"
                                android:textColor="@color/text_color_radio_segment"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </RadioGroup>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Match type"
                            android:textColor="@color/sub"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:scrollbars="none">

                            <RadioGroup
                                android:id="@+id/chipgroup_mode"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <RadioButton
                                    android:id="@+id/chip_mode_contains"
                                    android:layout_width="wrap_content"
                                    android:layout_height="34dp"
                                    android:layout_marginEnd="6dp"
                                    android:button="@null"
                                    android:gravity="center"
                                    android:paddingHorizontal="14dp"
                                    android:background="@drawable/bg_radio_segment"
                                    android:text="Contains"
                                    android:textColor="@color/text_color_radio_segment"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:checked="true" />

                                <RadioButton
                                    android:id="@+id/chip_mode_exact"
                                    android:layout_width="wrap_content"
                                    android:layout_height="34dp"
                                    android:layout_marginEnd="6dp"
                                    android:button="@null"
                                    android:gravity="center"
                                    android:paddingHorizontal="14dp"
                                    android:background="@drawable/bg_radio_segment"
                                    android:text="Exact"
                                    android:textColor="@color/text_color_radio_segment"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <RadioButton
                                    android:id="@+id/chip_mode_prefix"
                                    android:layout_width="wrap_content"
                                    android:layout_height="34dp"
                                    android:layout_marginEnd="6dp"
                                    android:button="@null"
                                    android:gravity="center"
                                    android:paddingHorizontal="14dp"
                                    android:background="@drawable/bg_radio_segment"
                                    android:text="Starts"
                                    android:textColor="@color/text_color_radio_segment"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <RadioButton
                                    android:id="@+id/chip_mode_suffix"
                                    android:layout_width="wrap_content"
                                    android:layout_height="34dp"
                                    android:layout_marginEnd="6dp"
                                    android:button="@null"
                                    android:gravity="center"
                                    android:paddingHorizontal="14dp"
                                    android:background="@drawable/bg_radio_segment"
                                    android:text="Ends"
                                    android:textColor="@color/text_color_radio_segment"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <RadioButton
                                    android:id="@+id/chip_mode_wildcard"
                                    android:layout_width="wrap_content"
                                    android:layout_height="34dp"
                                    android:layout_marginEnd="6dp"
                                    android:button="@null"
                                    android:gravity="center"
                                    android:paddingHorizontal="14dp"
                                    android:background="@drawable/bg_radio_segment"
                                    android:text="Wildcard"
                                    android:textColor="@color/text_color_radio_segment"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <RadioButton
                                    android:id="@+id/chip_mode_regex"
                                    android:layout_width="wrap_content"
                                    android:layout_height="34dp"
                                    android:button="@null"
                                    android:gravity="center"
                                    android:paddingHorizontal="14dp"
                                    android:background="@drawable/bg_radio_segment"
                                    android:text="Regex"
                                    android:textColor="@color/text_color_radio_segment"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </RadioGroup>
                        </HorizontalScrollView>

                        <TextView
                            android:id="@+id/tv_regex_error"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="That is not a valid regular expression."
                            android:textColor="@color/block"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Action"
                            android:textColor="@color/sub"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <RadioGroup
                            android:id="@+id/toggle_action"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal">

                            <RadioButton
                                android:id="@+id/btn_action_block"
                                android:layout_width="0dp"
                                android:layout_height="38dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="4dp"
                                android:button="@null"
                                android:gravity="center"
                                android:background="@drawable/bg_radio_segment"
                                android:text="Block (mute)"
                                android:textColor="@color/text_color_radio_segment"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:checked="true" />

                            <RadioButton
                                android:id="@+id/btn_action_allow"
                                android:layout_width="0dp"
                                android:layout_height="38dp"
                                android:layout_weight="1"
                                android:layout_marginStart="4dp"
                                android:button="@null"
                                android:gravity="center"
                                android:background="@drawable/bg_radio_segment"
                                android:text="Allow (show)"
                                android:textColor="@color/text_color_radio_segment"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </RadioGroup>

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_add_rule"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="12dp"
                            android:text="Add rule"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:background="@drawable/bg_tab_indicator" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Allow rules always win, keeping critical codes and messages coming even from blocked senders."
                            android:textColor="@color/sub"
                            android:textSize="12sp"
                            android:lineSpacingExtra="2dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Try it Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Try it"
                            android:textColor="@color/ink"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="8dp"
                            android:text="Preview what the active shields and rules do to a message. Nothing is sent or saved."
                            android:textColor="@color/sub"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/et_test_sender"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/bg_input"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="10dp"
                            android:hint="Sender name or number"
                            android:textColorHint="@color/sub"
                            android:textColor="@color/ink"
                            android:textSize="14sp"
                            android:inputType="textNoSuggestions" />

                        <EditText
                            android:id="@+id/et_test_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_input"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="10dp"
                            android:hint="Message text"
                            android:textColorHint="@color/sub"
                            android:textColor="@color/ink"
                            android:textSize="14sp"
                            android:lines="3"
                            android:gravity="top|start" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tv_test_chip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:background="@drawable/bg_chip_shown"
                                android:textColor="@color/allow"
                                tools:text="Would show" />

                            <TextView
                                android:id="@+id/tv_test_reason"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:textColor="@color/sub"
                                android:textSize="12sp"
                                android:singleLine="true"
                                android:ellipsize="end"
                                tools:text="No rule" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Your Custom Rules Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="6dp"
                    android:text="YOUR CUSTOM RULES"
                    android:textColor="@color/sub"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

                <TextView
                    android:id="@+id/tv_empty_rules"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingVertical="16dp"
                    android:text="No custom rules added yet."
                    android:textColor="@color/ink"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_rules"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </FrameLayout>

</LinearLayout>
